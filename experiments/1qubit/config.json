{
  "dataset": {
    "n_circuits": 100,
    "moments": 10,
    "qubits": 1,
    "primitive_gates": ["rz", "rx"],
    "distributed_clifford": false,
    "clifford": true,
    "mixed": false
  },
  "noise": {
    "noise_list": [
      {"gate": "rz", "noise_channel": "depolarizing", "noise_parameter": 0.02, "angle_dependent": false},
      {"gate": "rx", "noise_channel": "damping",      "noise_parameter": 0.03, "angle_dependent": false},
      {"gate": "rx", "noise_channel": "coherent_x",   "noise_parameter": 0.04, "angle_dependent": false},
      {"gate": "rz", "noise_channel": "coherent_z",   "noise_parameter": 0.02, "angle_dependent": false}
    ]
  },
  "gym_env": {
    "kernel_size": 3,
    "action_penalty": 0.0,
    "action_space_max_value": 0.06,
    "enable_only_depolarizing": false,
    "val_split": 0.2
  },
  "reward": {
    "metric": "trace",
    "function": "inverted_squared",
    "alpha": 20.0
  },
  "agent": {
    "policy": "MlpPolicy",
    "features_dim": 32,
    "filter_size": 1,
    "n_filters": 16,
    "pi_net_arch": [32, 32],
    "vf_net_arch": [32, 32],
    "n_steps": 1000,
    "batch_size": 200,
    "learning_rate": 1e-4
  },
  "rb": {
    "start": 3,
    "stop": 31,
    "step": 3,
    "n_circ": 50
  },
  "eval_n_circuits": 200,
  "eval_depth": 15,
  "eval_clifford": false,
  "total_timesteps": 200000,
  "check_freq": 2000
}
