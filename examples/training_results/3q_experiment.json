{
  "dataset": {
    "n_circuits": 800,
    "moments": 20,
    "qubits": 3,
    "primitive_gates": [
      "rz",
      "rx",
      "cz"
    ],
    "distributed_clifford": false,
    "clifford": false,
    "mixed": true
  },
  "noise": {
    "noise_list": [
      {
        "gate": "rz",
        "noise_channel": "depolarizing",
        "noise_parameter": 0.02,
        "angle_dependent": false
      },
      {
        "gate": "cz",
        "noise_channel": "depolarizing",
        "noise_parameter": 0.02,
        "angle_dependent": false
      },
      {
        "gate": "rx",
        "noise_channel": "damping",
        "noise_parameter": 0.03,
        "angle_dependent": false
      },
      {
        "gate": "cz",
        "noise_channel": "damping",
        "noise_parameter": 0.03,
        "angle_dependent": false
      },
      {
        "gate": "rx",
        "noise_channel": "coherent_x",
        "noise_parameter": 0.04,
        "angle_dependent": false
      },
      {
        "gate": "rz",
        "noise_channel": "coherent_z",
        "noise_parameter": 0.03,
        "angle_dependent": false
      }
    ]
  },
  "gym_env": {
    "kernel_size": 3,
    "action_penalty": 0.0,
    "action_space_max_value": 0.06,
    "enable_only_depolarizing": false,
    "val_split": 0.2
  },
  "reward": {
    "metric": "trace",
    "function": "inverted_squared",
    "alpha": 20.0
  },
  "agent": {
    "policy": "MlpPolicy",
    "features_dim": 64,
    "filter_size": 1,
    "n_filters": 32,
    "pi_net_arch": [
      32,
      32
    ],
    "vf_net_arch": [
      32,
      32
    ],
    "n_steps": 2000,
    "batch_size": 100,
    "learning_rate": 0.0001,
    "gamma": 0.99,
    "clip_range": 0.2,
    "verbose": 1
  },
  "rb": null
}